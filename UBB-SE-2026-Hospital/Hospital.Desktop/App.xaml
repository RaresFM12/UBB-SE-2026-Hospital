<Application
    x:Class="Hospital.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="HospitalAccentBrush" Color="#006A6A" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#006A6A" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="White" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1F2937" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#16A34A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
