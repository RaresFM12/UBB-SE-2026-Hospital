<Page
    x:Class="Hospital.Desktop.Views.Doctor.ShiftSwapRequestsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="My Shift Swap Requests" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel>
                    <TextBlock Text="Shift Id" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBox Width="120" Text="{Binding ShiftIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Colleague Id" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBox Width="120" Text="{Binding ColleagueIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Content="Request Swap" VerticalAlignment="Bottom" Command="{Binding RequestSwapCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <StackPanel>
                <Grid Padding="8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Swap Id" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Shift Id" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Colleague Id" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Status" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Requested At" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                </Grid>
                <ListView ItemsSource="{Binding Requests}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SwapId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ShiftId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ColleagueId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="{Binding RequestedAt}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
