<Page
    x:Class="Hospital.Desktop.Views.Doctor.IncomingSwapsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Incoming Swap Requests" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <StackPanel>
                <Grid Padding="8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Swap Id" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Shift Id" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Requester Id" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Requested At" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                </Grid>
                <ListView ItemsSource="{Binding Requests}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SwapId}" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ShiftId}" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RequesterId}" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding RequestedAt}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Accept" Command="{Binding DataContext.AcceptCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <Button Content="Reject" Command="{Binding DataContext.RejectCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
