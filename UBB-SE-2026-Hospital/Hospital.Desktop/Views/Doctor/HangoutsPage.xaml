<Page
    x:Class="Hospital.Desktop.Views.Doctor.HangoutsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Hangouts" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Create Hangout" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                <TextBox Header="Title" Text="{Binding NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Header="Description" Text="{Binding NewDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <DatePicker Header="Date" Date="{Binding NewDate, Mode=TwoWay}"/>
                    <NumberBox Header="Max Participants" Value="{Binding NewMaxParticipants, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline"/>
                    <Button Content="Create" VerticalAlignment="Bottom" Command="{Binding CreateCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <ListView ItemsSource="{Binding Hangouts}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Title" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Date" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Participants" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ParticipantsLabel}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
