<Window
    x:Class="Hospital.Desktop.Views.Patient.PatientProfileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hospital.Desktop.Converters"
    xmlns:model="using:Hospital.Data.Models">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:DateToStringConverter x:Key="DateToStringConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2A37" Padding="20">
            <StackPanel Spacing="10">
                <Button
                    Content="Back"
                    Click="BackButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    CornerRadius="6" />
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="White">
                    <Run Text="{Binding SelectedPatient.FirstName}" />
                    <Run Text=" Medical Information" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Padding="20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="15">
                    <Border Background="#2C3A4A" CornerRadius="10" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Patient Information" FontSize="16" FontWeight="Bold" Foreground="White" />
                            <TextBlock Foreground="LightGray"><Run Text="Name: " /><Run Text="{Binding SelectedPatient.FirstName}" /></TextBlock>
                            <TextBlock Foreground="LightGray"><Run Text="Last Name: " /><Run Text="{Binding SelectedPatient.LastName}" /></TextBlock>
                            <TextBlock Foreground="LightGray"><Run Text="DOB: " /><Run Text="{Binding SelectedPatient.DateOfBirth, Converter={StaticResource DateToStringConverter}}" /></TextBlock>
                            <TextBlock Foreground="LightGray"><Run Text="CNP: " /><Run Text="{Binding SelectedPatient.Cnp}" /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="#2C3A4A" CornerRadius="10" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Medical History" FontSize="14" FontWeight="Bold" Foreground="White" />

                            <StackPanel Spacing="5">
                                <TextBlock Text="Blood Type" Foreground="Gray" FontSize="12" />
                                <TextBlock Text="{Binding MedicalHistory.BloodType}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="RH Factor" Foreground="Gray" FontSize="12" />
                                <TextBlock Text="{Binding MedicalHistory.Rh}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Chronic Conditions" Foreground="Gray" FontSize="12" />
                                <TextBlock Text="{Binding ChronicConditionsFormatted}" Foreground="White" TextWrapping="WrapWholeWords" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#2C3A4A" CornerRadius="10" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Allergies" FontSize="14" FontWeight="Bold" Foreground="White" />

                            <ListView
                                ItemsSource="{Binding Allergies}"
                                SelectionMode="None"
                                BorderThickness="0"
                                Visibility="{Binding HasAllergies, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#3A4A5A" CornerRadius="6" Padding="12" Margin="0,5,0,0" BorderThickness="1" BorderBrush="#4A5A6A">
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                Text="No allergies recorded"
                                Foreground="Gray"
                                FontSize="12"
                                Visibility="{Binding HasNoAllergies, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#2C3A4A" CornerRadius="10" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Consultations" FontSize="14" FontWeight="Bold" Foreground="White" />

                            <ListView
                                x:Name="ConsultationList"
                                ItemsSource="{Binding MedicalRecords}"
                                SelectedItem="{Binding SelectedMedicalRecord, Mode=TwoWay}"
                                SelectionMode="Single"
                                Height="200"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                DoubleTapped="ConsultationList_DoubleTapped">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="model:MedicalRecord">
                                        <Border Padding="10" BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                                                    <Run Text="{Binding ConsultationDate, Converter={StaticResource DateToStringConverter}}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding SourceType}" Foreground="LightGray" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Border
                    Background="#2C3A4A"
                    CornerRadius="10"
                    Padding="20"
                    Visibility="{Binding HasSelectedMedicalRecord, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer>
                        <StackPanel Spacing="15">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Consultation Details" FontSize="18" FontWeight="Bold" Foreground="White" Grid.Column="0" />
                                <Button
                                    Grid.Column="1"
                                    Content="View Prescription"
                                    Click="ViewPrescription_Click"
                                    Background="#1B4965"
                                    Foreground="White"
                                    CornerRadius="6"
                                    Padding="15,8" />
                                <Button
                                    Grid.Column="2"
                                    Content="Apply Discount"
                                    Click="ApplyDiscount_Click"
                                    Background="#FFD700"
                                    Foreground="Black"
                                    CornerRadius="6"
                                    Padding="15,8"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding DiscountActionVisibility}" />
                            </Grid>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Patient Name" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Foreground="White" FontSize="14">
                                    <Run Text="{Binding SelectedPatient.FirstName}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding SelectedPatient.LastName}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Consultation Source" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedMedicalRecord.SourceType}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Staff" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StaffDisplay}" Foreground="White" FontSize="14" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Consultation Date" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Foreground="White" FontSize="14">
                                    <Run Text="{Binding SelectedMedicalRecord.ConsultationDate, Converter={StaticResource DateToStringConverter}}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Symptoms" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                <Border Background="#3A4A5A" CornerRadius="8" Padding="10">
                                    <TextBlock Text="{Binding SelectedMedicalRecord.Symptoms}" Foreground="White" TextWrapping="WrapWholeWords" FontSize="13" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Diagnosis" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                <Border Background="#3A4A5A" CornerRadius="8" Padding="10">
                                    <TextBlock Text="{Binding SelectedMedicalRecord.Diagnosis}" Foreground="White" TextWrapping="WrapWholeWords" FontSize="13" />
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10" Margin="0,15,0,0">
                                <TextBlock Text="Billing Information" FontSize="16" FontWeight="Bold" Foreground="White" />

                                <StackPanel Spacing="5">
                                    <TextBlock Text="Base Price (Calculated)" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BasePriceDisplay}" Foreground="#00FF00" FontSize="14" FontWeight="Bold" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="5"
                                    Visibility="{Binding DiscountApplied, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Final Price" Foreground="Gray" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FinalPriceDisplay}" Foreground="#00FF00" FontSize="14" FontWeight="Bold" />
                                </StackPanel>

                                <Border
                                    Background="#1B4965"
                                    CornerRadius="8"
                                    Padding="10"
                                    Visibility="{Binding DiscountApplied, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Discount Applied" Foreground="#00FF00" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Foreground="LightGray" FontSize="11">
                                            <Run Text="Discount: " />
                                            <Run Text="{Binding DiscountSummary}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding BillingStatusMessage}" Foreground="#FFD700" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border
                    Background="#2C3A4A"
                    CornerRadius="10"
                    Padding="20"
                    Visibility="{Binding HasNoSelectedMedicalRecord, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="Select a consultation to view details" Foreground="Gray" FontSize="16" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
