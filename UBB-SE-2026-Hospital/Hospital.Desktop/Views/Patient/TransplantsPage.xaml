<Page
    x:Class="Hospital.Desktop.Views.Patient.TransplantsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Transplants" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh Transplants" Command="{Binding LoadTransplantsCommand}"/>
            <Button Content="Find Matches" Command="{Binding FindMatchesCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Requests" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <ListView ItemsSource="{Binding Transplants}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8">
                                    <TextBlock Text="{Binding TransplantId}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OrganType}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Matches" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <ListView ItemsSource="{Binding Matches}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8">
                                    <TextBlock Text="{Binding MatchId}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CompatibilityScore}" Foreground="{StaticResource AppAccentBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
