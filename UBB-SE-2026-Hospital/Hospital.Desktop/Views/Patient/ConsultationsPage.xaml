<Page
    x:Class="Hospital.Desktop.Views.Patient.ConsultationsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Consultations" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}"/>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="16">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Patient Id" Width="100" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBox Width="200" Text="{Binding PatientIdInput, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Record Id" Width="100" VerticalAlignment="Center" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBox Width="200" Text="{Binding RecordIdInput, Mode=TwoWay}"/>
                </StackPanel>
                <Button Content="Load Consultation" Command="{Binding LoadConsultationCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="16">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Patient:" Width="120" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PatientName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Base Price:" Width="120" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding BasePrice}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Prescription:" Width="120" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PrescriptionInfo}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
