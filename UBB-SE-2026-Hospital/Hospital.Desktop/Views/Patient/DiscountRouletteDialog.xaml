<ContentDialog
    x:Class="Hospital.Desktop.Views.Patient.DiscountRouletteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Discount Roulette"
    DefaultButton="None"
    IsSecondaryButtonEnabled="False">

    <Grid Padding="20" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="Try Your Luck - Spin the Wheel!" FontSize="16" FontWeight="Bold" Foreground="#1F2A37"/>
            <TextBlock Text="Base Price:" FontSize="12" Foreground="Gray"/>
            <TextBlock x:Name="BasePriceTextBlock" Text="{x:Bind BasePriceText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#00FF88"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1F2A37" CornerRadius="10" HorizontalAlignment="Center" Width="300" Height="300" Padding="20">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="250" Height="250" Fill="#2A3F54" Stroke="#FFD700" StrokeThickness="3"/>

                <Canvas Width="250" Height="250" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="WheelRotate" Angle="0"/>
                    </Canvas.RenderTransform>

                    <Path Fill="#FF4444" Data="M 125,125 L 125,0 A 125,125 0 0 1 243.8,86.4 Z" />
                    <Path Fill="#FF8844" Data="M 125,125 L 243.8,86.4 A 125,125 0 0 1 198.5,226.1 Z" />
                    <Path Fill="#FFCC44" Data="M 125,125 L 198.5,226.1 A 125,125 0 0 1 51.5,226.1 Z" />
                    <Path Fill="#44CC44" Data="M 125,125 L 51.5,226.1 A 125,125 0 0 1 6.2,86.4 Z" />
                    <Path Fill="#4444FF" Data="M 125,125 L 6.2,86.4 A 125,125 0 0 1 125,0 Z" />
                </Canvas>

                <Ellipse Width="80" Height="80" Fill="#1F2A37" Stroke="#FFD700" StrokeThickness="2"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="SpinButton" Width="70" Height="70" Background="#FFD700" Foreground="Black"
                        Content="SPIN" FontWeight="Bold" FontSize="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="SpinButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FF4444" Padding="10" CornerRadius="6" Grid.Column="0"><TextBlock Text="0%" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
            <Border Background="#FF8844" Padding="10" CornerRadius="6" Grid.Column="1"><TextBlock Text="10%" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
            <Border Background="#FFCC44" Padding="10" CornerRadius="6" Grid.Column="2"><TextBlock Text="25%" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
            <Border Background="#44CC44" Padding="10" CornerRadius="6" Grid.Column="3"><TextBlock Text="50%" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
            <Border Background="#4444FF" Padding="10" CornerRadius="6" Grid.Column="4"><TextBlock Text="100%" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
        </Grid>

        <StackPanel x:Name="ResultPanel" Grid.Row="3" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="DiscountResultTextBlock" FontSize="18" FontWeight="Bold" Foreground="#FFD700"/>
            <TextBlock x:Name="FinalPriceTextBlock" FontSize="16" FontWeight="Bold" Foreground="#00FF88"/>
        </StackPanel>
    </Grid>
</ContentDialog>
