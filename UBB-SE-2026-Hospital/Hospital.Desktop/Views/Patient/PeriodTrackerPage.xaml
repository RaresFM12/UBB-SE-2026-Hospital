<Page
    x:Class="Hospital.Desktop.Views.Patient.PeriodTrackerPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hospital.Desktop.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" Background="{StaticResource AppBackgroundBrush}">

            <!-- Title -->
            <TextBlock Text="Period Tracker" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource AppAccentBrush}"/>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="#B00020" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}, TargetNullValue=Collapsed, FallbackValue=Collapsed}"/>

            <!-- ═══ SETUP PROMPT (shown when no tracker configured) ═══ -->
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}"
                    BorderThickness="1" Padding="20" CornerRadius="8"
                    Visibility="{Binding HasPeriodTracker, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Text="No Period Tracker Configured" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="Set up your cycle below to start tracking your period, fertility window, and ovulation."
                               Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ═══ CYCLE OVERVIEW (3 cards) ═══ -->
            <Grid ColumnSpacing="12"
                  Visibility="{Binding HasPeriodTracker, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Current Phase -->
                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}"
                        BorderThickness="1" Padding="16" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Current Phase" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CurrentPhaseString}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AppAccentBrush}" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                            <Run Text="Day "/>
                            <Run Text="{Binding CurrentDayOfCycle}"/>
                            <Run Text=" of cycle"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Card 2: Next Period -->
                <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1"
                        Padding="16" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Next Period" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NextPeriodDateString}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding NextPeriodDistanceString}"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Ovulation -->
                <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1"
                        Padding="16" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ovulation" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding OvulationDistanceString}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                            <Run Text="{Binding DaysUntilOvulation}"/>
                            <Run Text=" days until ovulation"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ MONTH NAVIGATION + PHASE INTERVALS ═══ -->
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}"
                    BorderThickness="1" Padding="16" CornerRadius="8"
                    Visibility="{Binding HasPeriodTracker, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <!-- Month nav -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="&lt; Prev" Command="{Binding PrevMonthCommand}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentMonthName}" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>
                        <Button Grid.Column="2" Content="Next &gt;" Command="{Binding NextMonthCommand}"/>
                    </Grid>

                    <!-- Phase intervals legend -->
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#E57373" Width="12" Height="12" CornerRadius="2"/>
                            <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                <Run Text="Period: "/>
                                <Run Text="{Binding PeriodIntervalText}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Background="#81C784" Width="12" Height="12" CornerRadius="2"/>
                            <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                <Run Text="Low Fertility: "/>
                                <Run Text="{Binding LowFertilityIntervalText}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <Border Background="#64B5F6" Width="12" Height="12" CornerRadius="2"/>
                            <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                <Run Text="Ovulation: "/>
                                <Run Text="{Binding OvulationIntervalText}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Background="#FFB74D" Width="12" Height="12" CornerRadius="2"/>
                            <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                <Run Text="PMS: "/>
                                <Run Text="{Binding PmsIntervalText}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ TWO-COLUMN: CONFIG + NOTES ═══ -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cycle Configuration -->
                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}"
                        BorderThickness="1" Padding="16" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Cycle Configuration" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>

                        <DatePicker Header="Last Period Start Date"
                                    Date="{Binding StartDate, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"/>

                        <NumberBox Header="Cycle Length (days)"
                                   Value="{Binding CycleDays, Mode=TwoWay}"
                                   Minimum="20" Maximum="45"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1"/>

                        <NumberBox Header="Period Duration (days)"
                                   Value="{Binding PeriodLasts, Mode=TwoWay}"
                                   Minimum="1" Maximum="9"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1"/>

                        <ComboBox Header="PMS Severity"
                                  SelectedIndex="{Binding PmsOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Mild (3 days before)"/>
                            <ComboBoxItem Content="Moderate (6 days before)"/>
                            <ComboBoxItem Content="Severe (10 days before)"/>
                        </ComboBox>

                        <Button Content="Save Cycle" Command="{Binding SaveCycleCommand}"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Daily Notes -->
                <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1"
                        Padding="16" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Daily Notes" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>

                        <!-- Notes list -->
                        <ListView ItemsSource="{Binding Notes}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleNoteCommand, ElementName=Root}"
                                                  CommandParameter="{Binding NoteId}"
                                                  VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Body}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>

                                        <Button Grid.Column="3" Content="X"
                                                Command="{Binding DataContext.DeleteNoteCommand, ElementName=Root}"
                                                CommandParameter="{Binding NoteId}"
                                                FontSize="11" Padding="6,2"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Add note -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Write a note..."
                                     Text="{Binding NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Add Note" Command="{Binding AddNoteCommand}"/>
                        </Grid>

                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12">
                            <Run Text="{Binding Notes.Count, Mode=OneWay}"/>
                            <Run Text="/4 notes used"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ RECOMMENDED PRODUCTS ═══ -->
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}"
                    BorderThickness="1" Padding="16" CornerRadius="8"
                    Visibility="{Binding HasPeriodTracker, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Recommended Wellness Products" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}"/>
                        <Border Background="#E57373" CornerRadius="4" Padding="8,2"
                                Visibility="{Binding IsInMenstrualPhase, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="20% Menstrual Discount Active" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <GridView ItemsSource="{Binding ShopItems}" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}"
                                        BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1"
                                        Padding="12" CornerRadius="6" Width="200" Margin="4">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}"
                                                   TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock Text="{Binding PriceDisplay}"
                                                   Foreground="{StaticResource AppAccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
