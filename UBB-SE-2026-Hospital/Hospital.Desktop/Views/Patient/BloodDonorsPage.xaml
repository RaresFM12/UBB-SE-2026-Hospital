<Page
    x:Class="Hospital.Desktop.Views.Patient.BloodDonorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Blood Donors" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <ComboBox Width="320" PlaceholderText="Recipient patient" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" DisplayMemberPath="FullName"/>
            <Button Content="Find Donors" Command="{Binding LoadCompatibleDonorsCommand}"/>
            <Button Content="Refresh Patients" Command="{Binding LoadPatientsCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <ListView ItemsSource="{Binding Donors}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PatientId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cnp}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
