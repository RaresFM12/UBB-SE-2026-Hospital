<Page
    x:Class="Hospital.Desktop.Views.Patient.BloodDonorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Blood Donors" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <ComboBox Width="320" PlaceholderText="Recipient patient" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" DisplayMemberPath="FullName"/>
            <Button Content="Find Donors" Command="{Binding LoadCompatibleDonorsCommand}"/>
            <Button Content="Refresh Patients" Command="{Binding LoadPatientsCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <ListView ItemsSource="{Binding Donors}" HorizontalContentAlignment="Stretch">
                <ListView.Header>
                    <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="12,4" CornerRadius="4" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="0"/>
                        <TextBlock Text="NAME" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="1"/>
                        <TextBlock Text="CNP" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="2"/>
                        <TextBlock Text="PHONE" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="3"/>
                        <TextBlock Text="SEX" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="4"/>
                        <TextBlock Text="DOB" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="5"/>
                        <TextBlock Text="EMERGENCY" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="6"/>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PatientId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cnp}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding PhoneNumber}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Sex}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding DateOfBirth}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="6" Text="{Binding EmergencyContact}" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
