<Page
    x:Class="Hospital.Desktop.Views.Patient.OrganDonorPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Organ Donor" FontSize="28" FontWeight="SemiBold"
                   Foreground="{StaticResource AppAccentBrush}"/>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <StackPanel Spacing="4">
                    <TextBlock Text="Recipient Patient Id" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBox Width="160"
                             Text="{Binding RecipientPatientId, Mode=TwoWay}"
                             InputScope="Number"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Organ" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <ComboBox Width="160"
                              ItemsSource="{Binding Organs}"
                              SelectedItem="{Binding SelectedOrgan, Mode=TwoWay}"/>
                </StackPanel>
                <Button Content="Find Donors" Command="{Binding FindDonorsCommand}" VerticalAlignment="Bottom"/>
                <Button Content="Add to Waitlist" Command="{Binding AddToWaitlistCommand}" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <ListView ItemsSource="{Binding Donors}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Id" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Donor" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Blood Type" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Rh" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="Score" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PatientId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{Binding BloodType}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Rh}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Score}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <Button Grid.Column="5" Content="Assign Donor"
                                    Command="{Binding DataContext.AssignDonorCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
