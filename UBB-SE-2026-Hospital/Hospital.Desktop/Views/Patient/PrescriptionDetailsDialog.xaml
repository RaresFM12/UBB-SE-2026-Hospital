<ContentDialog
    x:Class="Hospital.Desktop.Views.Patient.PrescriptionDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:Hospital.Data.Models"
    Title="Prescription Details"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ScrollViewer>
        <StackPanel Spacing="15" Padding="20" MinWidth="420">
            <StackPanel Spacing="5">
                <TextBlock Text="Medications" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind MedicationItems, Mode=OneWay}" SelectionMode="None" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:PrescriptionItem">
                            <Border Background="#3A4A5A" CornerRadius="6" Padding="12" Margin="0,5,0,0" BorderThickness="1" BorderBrush="#4A5A6A">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind MedicationName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Foreground="LightGray" FontSize="12">
                                        <Run Text="Qty: "/>
                                        <Run Text="{x:Bind Quantity}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="No medications prescribed" Foreground="Gray" FontSize="12" Visibility="{x:Bind NoMedicationVisibility, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Doctor Notes" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                <Border Background="#3A4A5A" CornerRadius="8" Padding="10">
                    <TextBlock Text="{x:Bind DoctorNotes, Mode=OneWay}" Foreground="White" TextWrapping="WrapWholeWords" FontSize="13"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
