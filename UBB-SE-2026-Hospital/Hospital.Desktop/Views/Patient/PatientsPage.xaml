<Page
    x:Class="Hospital.Desktop.Views.Patient.PatientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hospital.Desktop.Converters"
    xmlns:model="using:Hospital.Data.Models">

    <Page.Resources>
        <converters:DateToStringConverter x:Key="DateToStringConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="PATIENT DIRECTORY" FontSize="14" FontWeight="Bold" Foreground="#4A90A4" CharacterSpacing="60" />
            <Grid ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    PlaceholderText="Search by Name or CNP..."
                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    CornerRadius="6" />
                <Button
                    Grid.Column="1"
                    Content="Search"
                    Command="{Binding LoadPatientsCommand}"
                    Background="#5EC499"
                    Foreground="White"
                    CornerRadius="6" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding StatusMessage}"
                    VerticalAlignment="Center"
                    Foreground="#D97706"
                    TextWrapping="Wrap" />
                <Border
                    Grid.Column="3"
                    Background="#EAF1FA"
                    BorderBrush="#D3DDEA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,12">
                    <StackPanel>
                        <TextBlock Text="Patients" FontWeight="SemiBold" Foreground="#5A6B84" />
                        <TextBlock Text="{Binding Patients.Count}" FontSize="24" FontWeight="Bold" Foreground="#1F2A37" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Background="#2C3A4A" Padding="14" CornerRadius="10">
            <TextBlock Text="Double-click a patient to open the full medical profile, exactly like the original 926-2 flow." Foreground="White" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="10" Padding="10">
            <ListView
                x:Name="PatientListView"
                ItemsSource="{Binding Patients}"
                SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                SelectionMode="Single"
                HorizontalContentAlignment="Stretch"
                DoubleTapped="PatientListView_DoubleTapped">
                <ListView.Header>
                    <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="12,4" CornerRadius="4" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FIRST NAME" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="0" Margin="10,0,0,0" />
                        <TextBlock Text="LAST NAME" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="1" Margin="10,0,0,0" />
                        <TextBlock Text="SEX" FontWeight="Bold" FontSize="11" Foreground="Gray" Grid.Column="2" HorizontalAlignment="Center" />
                        <TextBlock Text="DOB" FontWeight="Bold" FontSize="10" Foreground="Gray" Grid.Column="3" Margin="45,0,0,0" />
                        <TextBlock Text="CNP" FontWeight="Bold" FontSize="10" Foreground="Gray" Grid.Column="4" Margin="55,0,0,0" />
                        <TextBlock Text="PHONE" FontWeight="Bold" FontSize="10" Foreground="Gray" Grid.Column="5" Margin="45,0,0,0" />
                        <TextBlock Text="EMERGENCY" FontWeight="Bold" FontSize="10" Foreground="Gray" Grid.Column="6" Margin="30,0,0,0" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Patient">
                        <Grid Padding="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind FirstName}" Grid.Column="0" Foreground="Black" Margin="10,0,0,0" />
                            <TextBlock Text="{x:Bind LastName}" Grid.Column="1" Foreground="Black" Margin="10,0,0,0" />
                            <TextBlock Text="{x:Bind Sex}" Grid.Column="2" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DateOfBirth, Converter={StaticResource DateToStringConverter}}" Foreground="Black" Grid.Column="3" Margin="10,0,0,0" />
                            <TextBlock Text="{x:Bind Cnp}" Grid.Column="4" Foreground="Black" FontSize="12" Margin="10,0,0,0" />
                            <TextBlock Text="{x:Bind PhoneNumber}" Grid.Column="5" Foreground="Black" Margin="10,0,0,0" />
                            <TextBlock Text="{x:Bind EmergencyContact}" Grid.Column="6" Foreground="Black" FontStyle="Italic" Margin="10,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
