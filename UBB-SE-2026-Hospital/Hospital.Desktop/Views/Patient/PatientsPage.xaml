<Page
    x:Class="Hospital.Desktop.Views.Patient.PatientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Hospital.Desktop.Converters"
    xmlns:model="using:Hospital.Data.Models">

    <Page.Resources>
        <converters:DateToStringConverter x:Key="DateToStringConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style x:Key="ArcColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#999999" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel Spacing="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PATIENT DIRECTORY" FontSize="14" FontWeight="Bold"
                           Foreground="#4A90A4" CharacterSpacing="60" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                    <Button Content="Active Patients"
                            Click="ShowActivePatients_Click"
                            Background="#5EC499" Foreground="White"
                            CornerRadius="6 0 0 6" Padding="14,8" />
                    <Button Content="Archive"
                            Click="ShowArchive_Click"
                            Background="#4A5568" Foreground="White"
                            CornerRadius="0 6 6 0" Padding="14,8" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="Search by Name or CNP..."
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         CornerRadius="6" />
                <Button Grid.Column="1" Content="Search"
                        Command="{Binding LoadPatientsCommand}"
                        Background="#5EC499" Foreground="White" CornerRadius="6" />
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" Foreground="#D97706" TextWrapping="Wrap" />
                <Border Grid.Column="3" Background="#EAF1FA" BorderBrush="#D3DDEA"
                        BorderThickness="1" CornerRadius="10" Padding="18,10">
                    <StackPanel>
                        <TextBlock Text="{Binding ArchiveSectionTitle}"
                                   FontWeight="SemiBold" Foreground="#5A6B84" FontSize="12" />
                        <TextBlock Text="{Binding Patients.Count}"
                                   FontSize="24" FontWeight="Bold" Foreground="#1F2A37" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ── Main content ── -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ══ ACTIVE PATIENTS LIST ══ -->
            <Border Background="#F8FAFC" CornerRadius="10" Padding="10"
                    Visibility="{Binding ShowDeceasedArchive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ListView x:Name="PatientListView"
                          ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                          SelectionMode="Single"
                          HorizontalContentAlignment="Stretch"
                          DoubleTapped="PatientListView_DoubleTapped">
                    <ListView.Header>
                        <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                              Padding="12,6" CornerRadius="4" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FIRST NAME"    Grid.Column="0" Style="{StaticResource ColHeaderStyle}" />
                            <TextBlock Text="LAST NAME"     Grid.Column="1" Style="{StaticResource ColHeaderStyle}" />
                            <TextBlock Text="SEX"           Grid.Column="2" Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="DATE OF BIRTH" Grid.Column="3" Style="{StaticResource ColHeaderStyle}" />
                            <TextBlock Text="CNP"           Grid.Column="4" Style="{StaticResource ColHeaderStyle}" />
                            <TextBlock Text="PHONE"         Grid.Column="5" Style="{StaticResource ColHeaderStyle}" />
                            <TextBlock Text="EMERGENCY"     Grid.Column="6" Style="{StaticResource ColHeaderStyle}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Patient">
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FirstName}"        Grid.Column="0" Foreground="Black" />
                                <TextBlock Text="{Binding LastName}"         Grid.Column="1" Foreground="Black" />
                                <TextBlock Text="{Binding Sex}"              Grid.Column="2" Foreground="Black" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DateOfBirth, Converter={StaticResource DateToStringConverter}}" Grid.Column="3" Foreground="Black" />
                                <TextBlock Text="{Binding Cnp}"              Grid.Column="4" Foreground="Black" FontSize="12" />
                                <TextBlock Text="{Binding PhoneNumber}"      Grid.Column="5" Foreground="Black" />
                                <TextBlock Text="{Binding EmergencyContact}" Grid.Column="6" Foreground="Black" FontStyle="Italic" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- ══ ARCHIVE LIST (normal + deceased) ══ -->
            <Border Background="#1E232C" CornerRadius="10" Padding="10"
                    Visibility="{Binding ShowDeceasedArchive, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                          SelectionMode="Single"
                          HorizontalContentAlignment="Stretch">
                    <ListView.Header>
                        <Grid Padding="12,6" CornerRadius="4" Margin="0,0,0,6" Background="#2D3748">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FIRST NAME"    Grid.Column="0" Style="{StaticResource ArcColHeaderStyle}" />
                            <TextBlock Text="LAST NAME"     Grid.Column="1" Style="{StaticResource ArcColHeaderStyle}" />
                            <TextBlock Text="STATUS"        Grid.Column="2" Style="{StaticResource ArcColHeaderStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="DATE OF DEATH" Grid.Column="3" Foreground="#FF6B6B" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="DONOR"         Grid.Column="4" Foreground="#4CAF50" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock Text="CNP"           Grid.Column="5" Style="{StaticResource ArcColHeaderStyle}" />
                            <TextBlock Text="DATE OF BIRTH" Grid.Column="6" Style="{StaticResource ArcColHeaderStyle}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Patient">
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FirstName}" Grid.Column="0" Foreground="#EEEEEE" />
                                <TextBlock Text="{Binding LastName}"  Grid.Column="1" Foreground="#EEEEEE" />
                                <!-- Status badge -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border CornerRadius="4" Padding="6,2" Background="#8B3A3A"
                                            Visibility="{Binding IsDeceased, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="DECEASED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Background="#4A5568"
                                            Visibility="{Binding IsDeceased, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="ARCHIVED" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DateOfDeath, Converter={StaticResource DateToStringConverter}}"
                                           Grid.Column="3" Foreground="#FF8A80" FontWeight="SemiBold" />
                                <TextBlock Text="&#x2665;" Grid.Column="4" Foreground="#4CAF50" FontSize="16"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding IsDonor, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding Cnp}"         Grid.Column="5" Foreground="#CCCCCC" FontSize="12" />
                                <TextBlock Text="{Binding DateOfBirth, Converter={StaticResource DateToStringConverter}}"
                                           Grid.Column="6" Foreground="#CCCCCC" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- ══ DETAILS PANEL ══ -->
            <Border Grid.Column="1" Background="#1F2A37" CornerRadius="10" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!-- Nothing selected -->
                        <TextBlock Text="Select a patient to see details."
                                   Foreground="#5A6B84" FontStyle="Italic" TextWrapping="Wrap"
                                   Visibility="{Binding HasSelectedPatient, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <!-- ── ACTIVE patient panel ── -->
                        <StackPanel Spacing="10" Visibility="{Binding ActivePatientActionsVisibility}">
                            <TextBlock Text="Patient Details" FontSize="18" FontWeight="Bold" Foreground="White" />

                            <TextBlock Text="First Name" Foreground="#AAAAAA" FontSize="12" />
                            <TextBox Text="{Binding SelectedPatient.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Last Name" Foreground="#AAAAAA" FontSize="12" />
                            <TextBox Text="{Binding SelectedPatient.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Phone" Foreground="#AAAAAA" FontSize="12" />
                            <TextBox Text="{Binding SelectedPatient.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Emergency Contact" Foreground="#AAAAAA" FontSize="12" />
                            <TextBox Text="{Binding SelectedPatient.EmergencyContact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Content="Save Changes" Click="UpdatePatient_Click"
                                    HorizontalAlignment="Stretch" Background="#5EC499"
                                    Foreground="White" CornerRadius="6" Margin="0,6,0,0" />

                            <Button Content="Add to Archive" Click="ArchivePatient_Click"
                                    HorizontalAlignment="Stretch" Background="#4A5568"
                                    Foreground="White" CornerRadius="6" />
                        </StackPanel>

                        <!-- ── ARCHIVE patient panel ── -->
                        <StackPanel Spacing="10" Visibility="{Binding DeceasedArchiveActionsVisibility}">
                            <TextBlock Text="{Binding SelectedPatient.FullName}"
                                       FontSize="16" FontWeight="Bold" Foreground="White" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Born:" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedPatient.DateOfBirth, Converter={StaticResource DateToStringConverter}}"
                                           Foreground="White" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Dearchive button — always available -->
                            <Button Content="&#x2190;  Return to Active List" Click="Dearchive_Click"
                                    HorizontalAlignment="Stretch" Background="#2D3748"
                                    Foreground="#90CDF4" CornerRadius="6" />

                            <!-- ─ ALIVE in archive: can mark as deceased ─ -->
                            <Border Background="#2A1515" CornerRadius="6" Padding="12"
                                    Visibility="{Binding SelectedPatient.IsDeceased, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Mark as Deceased" FontWeight="Bold"
                                               Foreground="#FF6B6B" FontSize="13" />
                                    <TextBlock Text="Date of death" Foreground="#AAAAAA" FontSize="12" />
                                    <DatePicker SelectedDate="{Binding SelectedDeathDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" />
                                    <Button Content="Confirm — Mark as Deceased"
                                            Click="MarkAsDeceased_Click"
                                            HorizontalAlignment="Stretch"
                                            Background="#8B3A3A" Foreground="White" CornerRadius="6" />
                                </StackPanel>
                            </Border>

                            <!-- ─ DECEASED in archive: show death date + organ donor ─ -->
                            <StackPanel Spacing="8"
                                        Visibility="{Binding SelectedPatient.IsDeceased, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Background="#3A1A1A" CornerRadius="6" Padding="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Died:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedPatient.DateOfDeath, Converter={StaticResource DateToStringConverter}}"
                                                   Foreground="#FF8A80" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Organ donor -->
                                <Border Background="#1A2E1A" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ORGAN DONOR" FontWeight="Bold"
                                                   Foreground="#4CAF50" FontSize="12" CharacterSpacing="30" />

                                        <!-- Is donor -->
                                        <StackPanel Spacing="6"
                                                    Visibility="{Binding SelectedPatient.IsDonor, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#x2665;  Registered as organ donor"
                                                       Foreground="#4CAF50" FontWeight="SemiBold" FontSize="13" />
                                            <Button Content="Remove Donor Status" Click="RemoveDonor_Click"
                                                    HorizontalAlignment="Stretch"
                                                    Background="#3A1A1A" Foreground="#FF6B6B" CornerRadius="6" />
                                        </StackPanel>

                                        <!-- Not a donor -->
                                        <StackPanel Spacing="6"
                                                    Visibility="{Binding SelectedPatient.IsDonor, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <TextBlock Text="Not registered as organ donor"
                                                       Foreground="#888888" FontSize="12" />
                                            <Button Content="Register as Organ Donor" Click="AddDonor_Click"
                                                    HorizontalAlignment="Stretch"
                                                    Background="#2E7D32" Foreground="White" CornerRadius="6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
