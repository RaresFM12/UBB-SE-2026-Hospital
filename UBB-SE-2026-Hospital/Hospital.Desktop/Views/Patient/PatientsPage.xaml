<Page
    x:Class="Hospital.Desktop.Views.Patient.PatientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Patients" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <TextBox Width="260" PlaceholderText="Search by name" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Search" Command="{Binding LoadPatientsCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <ListView ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PatientId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Cnp}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding PhoneNumber}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Selected Patient" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedPatient.FullName, FallbackValue='No patient selected'}" Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedPatient.Cnp}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedPatient.EmergencyContact}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Medical Records" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <ListView ItemsSource="{Binding MedicalRecords}" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="6">
                                    <TextBlock Text="{Binding Diagnosis}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Symptoms}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ConsultationDate}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
