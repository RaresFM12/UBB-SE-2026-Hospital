<Page
    x:Class="Hospital.Desktop.Views.Patient.PrescriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:Hospital.Data.Models">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandDark" Color="#1E2A38"/>
        <SolidColorBrush x:Key="BrandPrimary" Color="#2A6478"/>
        <SolidColorBrush x:Key="BrandSecondary" Color="#4A90A4"/>
        <SolidColorBrush x:Key="BrandAccent" Color="#5EC499"/>
        <SolidColorBrush x:Key="GhostAccent" Color="#FFE779"/>
    </Page.Resources>

    <Grid Background="#F4F6F8" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PRESCRIPTIONS FEED" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandSecondary}" CharacterSpacing="50" />
            <TextBlock Text="Chronological Overview" FontSize="26" Foreground="{StaticResource BrandDark}" FontWeight="Bold" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BrandDark}" CornerRadius="8" Padding="20,10,20,10" Margin="0,0,0,10" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Filter Options" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBox Width="80" MinWidth="80" Height="36" CornerRadius="6" VerticalContentAlignment="Center" PlaceholderText="ID..." Text="{Binding SearchIdText, Mode=TwoWay}" />
                    <TextBox Width="160" Height="36" CornerRadius="6" VerticalContentAlignment="Center" PlaceholderText="Patient Name" Text="{Binding SearchName, Mode=TwoWay}" />
                    <TextBox Width="150" Height="36" CornerRadius="6" VerticalContentAlignment="Center" PlaceholderText="Medication Name" Text="{Binding SearchMedication, Mode=TwoWay}" />
                    <CalendarDatePicker Width="140" Height="36" CornerRadius="6" VerticalAlignment="Center" PlaceholderText="Date From" Date="{Binding DateFrom, Mode=TwoWay}" />
                    <TextBlock Text="-" VerticalAlignment="Center" Foreground="#A1A1AA" FontWeight="Bold" />
                    <CalendarDatePicker Width="140" Height="36" CornerRadius="6" VerticalAlignment="Center" PlaceholderText="Date To" Date="{Binding DateTo, Mode=TwoWay}" />
                    <Button Content="Search" Width="90" Height="36" Command="{Binding ApplyFilterCommand}" Background="{StaticResource BrandAccent}" Foreground="White" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource GhostAccent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <GridView ItemsSource="{Binding Prescriptions}" SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="model:Prescription">
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Width="280" Height="135" Margin="6" Padding="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" HorizontalAlignment="Center" Background="#F0F9F6" BorderBrush="{StaticResource BrandAccent}" BorderThickness="1" CornerRadius="20" Padding="10,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE814;" Foreground="{StaticResource BrandPrimary}" FontSize="12" />
                                        <TextBlock Text="{Binding PrescriptionId}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandPrimary}" />
                                    </StackPanel>

                                    <Button.Flyout>
                                        <Flyout>
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="10" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <StackPanel Width="230" Padding="15">
                                                <TextBlock Text="Medication Details" FontWeight="Bold" FontSize="15" Foreground="#1E2A38" Margin="0,0,0,15" />
                                                <ListView ItemsSource="{Binding MedicationList}" SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="model:PrescriptionItem">
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE1D0;" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding MedicationName}" FontSize="12" FontWeight="SemiBold" Foreground="#1E2A38" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#F4F6F8" CornerRadius="4" Padding="6,2" BorderBrush="#E5E7EB" BorderThickness="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                    <TextBlock Text="{Binding Quantity}" FontSize="10" FontWeight="SemiBold" Foreground="#4B5563" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <StackPanel Grid.Row="1" Margin="0,5,0,0" Spacing="1">
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="Patient: " FontWeight="SemiBold" Foreground="#1E2A38" />
                                        <Run Text="{Binding PatientName}" Foreground="#4B5563" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="Doctor: " FontWeight="SemiBold" Foreground="#1E2A38" />
                                        <Run Text="{Binding DoctorName}" Foreground="#4B5563" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0">
                                        <Run Text="Instructions:" FontWeight="SemiBold" FontSize="10" Foreground="#1E2A38" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DoctorNotes}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="#4B5563" FontSize="10" />
                                </StackPanel>

                                <Border Grid.Row="2" Background="#F4F6F8" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE787;" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center" />
                                        <TextBlock Foreground="#6B7280" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Date}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30" Margin="0,20,0,0">
            <Button Command="{Binding PrevPageCommand}" Width="110" Height="40" CornerRadius="20" Background="#00A896" BorderThickness="0" Foreground="White" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="Previous" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Background="{StaticResource BrandDark}" CornerRadius="20" Padding="20,0" Height="40" VerticalAlignment="Center">
                <TextBlock Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Run Text="PAGE " />
                    <Run Text="{Binding CurrentPage}" />
                </TextBlock>
            </Border>

            <Button Command="{Binding NextPageCommand}" Width="110" Height="40" CornerRadius="20" Background="#00A896" BorderThickness="0" Foreground="White" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Next" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE72A;" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
