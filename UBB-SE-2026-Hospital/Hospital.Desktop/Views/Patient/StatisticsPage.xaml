<Page
    x:Class="Hospital.Desktop.Views.Patient.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Statistics" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding LoadStatisticsCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Active vs Archived" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ActiveVsArchived}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding Key}"/><Run Text=": "/><Run Text="{Binding Value}"/></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Age Distribution" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding AgeDistribution}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Blood Types" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding PatientsByBloodType}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Rh Factor" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding PatientsByRh}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Gender" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding GenderDistribution}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Consultations" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ConsultationDistribution}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="48">
                        <StackPanel>
                            <TextBlock Text="Top Diagnoses" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding TopDiagnoses}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Most Prescribed Meds" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding MostPrescribedMeds}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
