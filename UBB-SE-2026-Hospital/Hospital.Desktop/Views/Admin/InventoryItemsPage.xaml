<Page
    x:Class="Hospital.Desktop.Views.Admin.InventoryItemsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Inventory Items" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search by name..."
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="2"
                              Header="Show expired only"
                              OffContent="Off" OnContent="On"
                              IsOn="{Binding ShowExpiredOnly, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource AppTextPrimaryBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
            <ListView ItemsSource="{Binding Items}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Producer" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Category" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="Qty" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="Discount" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Producer}" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Price}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding Quantity}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding DiscountPercentage}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="6" Content="Delete" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
