<Page
    x:Class="Hospital.Desktop.Views.Admin.NotificationsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Send System Notification" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}"/>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="16" VerticalAlignment="Top">
            <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left">
                <TextBox Header="Recipient Staff Id" InputScope="Number" Text="{Binding RecipientStaffId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Header="Title" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Header="Message" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Send" Command="{Binding SendCommand}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
