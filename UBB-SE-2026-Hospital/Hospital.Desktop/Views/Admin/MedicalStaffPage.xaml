<Page
    x:Class="Hospital.Desktop.Views.Admin.MedicalStaffPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Medical Staff" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Padding="8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ID" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Name" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Role" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="Department" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="Specialization" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Text="Status" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="6" Text="Available" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding Staff}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StaffId}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Department}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Specialization}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="6" Text="{Binding Available}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
