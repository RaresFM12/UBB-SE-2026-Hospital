<Page
    x:Class="Hospital.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Dashboard"
            FontSize="32"
            FontWeight="SemiBold"
            Foreground="{StaticResource AppAccentBrush}"/>

        <StackPanel Grid.Row="1" Spacing="16" Margin="0,24,0,0">
            <TextBlock
                Text="Welcome to the unified Hospital Desktop application."
                FontSize="18"
                Foreground="{StaticResource AppTextPrimaryBrush}"/>

            <TextBlock
                Text="Use the navigation pane on the left to access different modules:"
                FontSize="14"
                Foreground="{StaticResource AppTextSecondaryBrush}"/>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Admin &amp; Client" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Accounts, Appointments, ER Dispatch, Fatigue Audit, Schedule, Shift Management" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Emergency Room" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Triage, Queue, Patient Registration, Room Management, Examination, Transfer Log" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Patient &amp; Billing" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AppAccentBrush}"/>
                        <TextBlock Text="Patients, Prescriptions, Transplants, Blood Donors, Statistics, Billing, Addict Detection" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
