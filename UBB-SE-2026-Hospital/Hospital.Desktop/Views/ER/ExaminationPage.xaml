<Page
    x:Class="Hospital.Desktop.Views.ER.ExaminationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Examination" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadDataCommand}"/>
            <Button Content="Request Doctor" Command="{Binding RequestDoctorCommand}"/>
            <Button Content="Save Examination" Command="{Binding SaveExaminationCommand}"/>
            <Button Content="View Summary" Command="{Binding ViewSummaryCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ready And Ongoing Visits" FontWeight="SemiBold"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding EligibleVisits}" SelectedItem="{Binding SelectedVisit, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold">
                                            <Run Text="Visit #"/>
                                            <Run Text="{Binding VisitId}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold">
                                            <Run Text="{Binding Patient.FirstName}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Patient.LastName}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ChiefComplaint}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold">
                                            <Run Text="Status: "/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ArrivalDateTime}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Examination Details" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Enabled"
                                  HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="10" Padding="0,0,8,0">
                            <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding TriageLevelDisplay}" Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TriageSpecialization}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TriageNurseId}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBox Header="Doctor ID" Text="{Binding DoctorId}" IsReadOnly="True"/>
                            <TextBox Header="Assigned Doctor" Text="{Binding DoctorName}" IsReadOnly="True"/>
                            <TextBox Header="Specialty" Text="{Binding DoctorSpecialty}" IsReadOnly="True"/>
                            <TextBox Header="Notes" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="140"/>
                            <TextBlock Text="Previous Examination Notes" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <ListView ItemsSource="{Binding ExaminationHistory}" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                                    <Run Text="Exam on "/>
                                                    <Run Text="{Binding ExaminationDate}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
