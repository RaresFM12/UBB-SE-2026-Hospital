<Page
    x:Class="Hospital.Desktop.Views.ER.RoomManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Room Management" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh Rooms" Command="{Binding LoadRoomsCommand}"/>
            <Button Content="Mark Cleaning" Command="{Binding MarkRoomAsCleaningCommand}"/>
            <Button Content="Mark Available" Command="{Binding MarkRoomAsCleanedCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
            <TextBlock Text="{Binding TotalRooms}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding AvailableCount}" Foreground="{StaticResource AppAccentBrush}"/>
            <TextBlock Text="{Binding OccupiedCount}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
            <TextBlock Text="{Binding CleaningCount}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Available" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{Binding AvailableRooms}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8" Text="{Binding RoomTypeName}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Occupied" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{Binding OccupiedRooms}" SelectedItem="{Binding SelectedOccupiedRoom, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8" Text="{Binding RoomTypeName}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Cleaning" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{Binding CleaningRooms}" SelectedItem="{Binding SelectedCleaningRoom, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8" Text="{Binding RoomTypeName}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource AppErrorBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
