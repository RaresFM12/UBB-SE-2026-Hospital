<Page
    x:Class="Hospital.Desktop.Views.ER.TriagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Triage" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" CornerRadius="12" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Triage Inbox" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <Button Grid.Row="1" Content="Load Visits" Command="{Binding LoadVisitsForTriageCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Row="2" Text="{Binding RegisteredVisitsStatusText}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    <ListView Grid.Row="3" ItemsSource="{Binding RegisteredVisits}" SelectedItem="{Binding SelectedVisit, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}">
                                            <Run Text="Visit #"/>
                                            <Run Text="{Binding VisitId}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Patient.FirstName}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ChiefComplaint}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AppAccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Triage Parameters" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                        <Run Text="Selected visit: "/>
                        <Run Text="{Binding SelectedVisitLabel}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedVisit.ChiefComplaint, FallbackValue='Select a visit from the left to start triage.'}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <TextBlock
                            Text="Score each parameter from 1 (mild/stable) to 3 (severe/critical)."
                            Foreground="{StaticResource AppTextSecondaryBrush}"
                            TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}">
                        <Run Text="Consciousness: "/>
                        <Run Text="{Binding Consciousness}"/>
                    </TextBlock>
                    <Slider Minimum="1" Maximum="3" Value="{Binding Consciousness, Mode=TwoWay}" TickFrequency="1" SnapsTo="Ticks"/>
                    <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}">
                        <Run Text="Breathing: "/>
                        <Run Text="{Binding Breathing}"/>
                    </TextBlock>
                    <Slider Minimum="1" Maximum="3" Value="{Binding Breathing, Mode=TwoWay}" TickFrequency="1" SnapsTo="Ticks"/>
                    <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}">
                        <Run Text="Bleeding: "/>
                        <Run Text="{Binding Bleeding}"/>
                    </TextBlock>
                    <Slider Minimum="1" Maximum="3" Value="{Binding Bleeding, Mode=TwoWay}" TickFrequency="1" SnapsTo="Ticks"/>
                    <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}">
                        <Run Text="Injury Type: "/>
                        <Run Text="{Binding InjuryType}"/>
                    </TextBlock>
                    <Slider Minimum="1" Maximum="3" Value="{Binding InjuryType, Mode=TwoWay}" TickFrequency="1" SnapsTo="Ticks"/>
                    <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}">
                        <Run Text="Pain Level: "/>
                        <Run Text="{Binding PainLevel}"/>
                    </TextBlock>
                    <Slider Minimum="1" Maximum="3" Value="{Binding PainLevel, Mode=TwoWay}" TickFrequency="1" SnapsTo="Ticks"/>

                    <Button Content="Perform Triage" Command="{Binding PerformTriageCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsNotTriaged}"/>
                    <Button Content="Move to Queue" Command="{Binding MoveToQueueCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsTriaged}"/>
                    <Button Content="Close Visit" Command="{Binding CancelTriageCommand}" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="{Binding TriageResultText}" Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SpecializationResultText}" Foreground="{StaticResource AppAccentBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
