<Page
    x:Class="Hospital.Desktop.Views.ER.TransferLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Transfer Log" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadDataCommand}"/>
            <Button Content="Send Patient Data" Command="{Binding SendPatientDataCommand}"/>
            <Button Content="Close Visit" Command="{Binding CloseVisitCommand}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Selected Patient" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedVisit.PatientName, FallbackValue='No visit selected'}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Current Step" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedVisit.Status, FallbackValue='Select a visit ready for transfer'}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Chief Complaint" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedVisit.ChiefComplaint, FallbackValue='No complaint loaded'}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Visits Ready For Transfer" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding EligibleVisits}" SelectedItem="{Binding SelectedVisit, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold">
                                            <Run Text="Visit #"/>
                                            <Run Text="{Binding VisitId}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding PatientName}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ChiefComplaint}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold">
                                            <Run Text="Status: "/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                            <Run Text="Transferred flag: "/>
                                            <Run Text="{Binding Transferred}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Transfer Attempts" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding TransferLogs}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold">
                                            <Run Text="Attempt #"/>
                                            <Run Text="{Binding TransferLogId}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold">
                                            <Run Text="Status: "/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TransferTime}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Visibility="{Binding ExaminationSummaryVisibility}"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppAccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <StackPanel Spacing="6">
                <TextBlock Text="Transferred Examination Summary" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock>
                    <Run Text="Patient: "/>
                    <Run Text="{Binding ExaminationSummary.FirstName}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding ExaminationSummary.LastName}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Complaint: "/>
                    <Run Text="{Binding ExaminationSummary.ChiefComplaint}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Triage: Level "/>
                    <Run Text="{Binding ExaminationSummary.TriageLevel}"/>
                    <Run Text=", "/>
                    <Run Text="{Binding ExaminationSummary.Specialization}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Severity score: "/>
                    <Run Text="{Binding ExaminationSummary.SeverityScore}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Doctor: "/>
                    <Run Text="{Binding ExaminationSummary.AssignedDoctorName}"/>
                </TextBlock>
                <TextBlock Text="{Binding ExaminationSummary.Notes}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
