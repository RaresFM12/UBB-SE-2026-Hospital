<Page
    x:Class="Hospital.Desktop.Views.ER.RoomAssignmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Room Assignment" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadDataCommand}"/>
            <Button Content="Auto Assign" Command="{Binding AssignRoomCommand}"/>
            <Button Content="Manual Assign" Command="{Binding ManualAssignRoomCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Waiting Visits" FontWeight="SemiBold"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding WaitingVisits}" SelectedItem="{Binding SelectedVisit, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}">
                                            <Run Text="Visit #"/>
                                            <Run Text="{Binding VisitId}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding PatientName}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ChiefComplaint}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold">
                                            <Run Text="Triage Level "/>
                                            <Run Text="{Binding TriageLevel}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Specialization}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}">
                                            <Run Text="Status: "/>
                                            <Run Text="{Binding Status}"/>
                                            <Run Text="  "/>
                                            <Run Text="Arrived at "/>
                                            <Run Text="{Binding ArrivalTime}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Available Rooms" FontWeight="SemiBold"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding AvailableRooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}">
                                            <Run Text="Room #"/>
                                            <Run Text="{Binding RoomId}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RoomTypeName}" Foreground="{StaticResource AppAccentBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AvailabilityStatus}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ActionFeedback}" Foreground="{StaticResource AppAccentBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
