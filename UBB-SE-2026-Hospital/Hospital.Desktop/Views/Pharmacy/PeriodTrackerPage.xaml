<Page
    x:Class="Hospital.Desktop.Views.Pharmacy.PeriodTrackerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Hospital.Desktop.ViewModels.Pharmacy"
    xmlns:local="using:Hospital.Desktop.Views.Pharmacy"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:InlineBoolToVisConverter x:Key="InlineBoolToVis" />
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel BorderBrush="{StaticResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                <TextBlock Text="Period Tracker Center" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentColor}" />
                <TextBlock Text="Configure the cycle, review the current phase, manage notes, and view recommended items." Foreground="Gray" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.HasPeriodTracker), Mode=OneWay}" 
                        HorizontalAlignment="Center" Margin="0,40">
                <TextBlock Text="No configuration loaded" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Please configure your tracking parameters below to generate the dashboard." Foreground="Gray" HorizontalAlignment="Center" Margin="0,8"/>
            </StackPanel>

            <StackPanel Visibility="{x:Bind GetDashboardVisibility(ViewModel.HasPeriodTracker), Mode=OneWay}" Spacing="24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="&lt;" Click="ChangeMonth_Prev_Click" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentMonthName, Mode=OneWay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="&gt;" Click="ChangeMonth_Next_Click" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#196f53" BorderThickness="1" CornerRadius="8" Padding="16" Background="#f8faf9">
                        <StackPanel>
                            <TextBlock Text="Today" FontWeight="Bold" Foreground="#196f53" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentPhaseString, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Active Phase" Foreground="#e84c6c" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#196f53" BorderThickness="1" CornerRadius="8" Padding="16" Background="#f8faf9">
                        <StackPanel>
                            <TextBlock Text="Next Period" FontWeight="Bold" Foreground="#196f53" />
                            <TextBlock Text="{x:Bind ViewModel.NextPeriodDateString, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="{x:Bind ViewModel.NextPeriodDistanceString, Mode=OneWay}" Foreground="#e84c6c" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#196f53" BorderThickness="1" CornerRadius="8" Padding="16" Background="#f8faf9">
                        <StackPanel>
                            <TextBlock Text="Ovulation" FontWeight="Bold" Foreground="#196f53" />
                            <TextBlock Text="Calculated Date" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="{x:Bind ViewModel.OvulationDistanceString, Mode=OneWay}" Foreground="#e38234" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PeriodIntervalText, Mode=OneWay}" Foreground="#e82a4d" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.LowFertilityIntervalText, Mode=OneWay}" Foreground="#27a256" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.OvulationIntervalText, Mode=OneWay}" Foreground="#1ca2cc" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.PmsIntervalText, Mode=OneWay}" Foreground="#f16912" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Border Background="#333" Padding="12" CornerRadius="8,8,0,0">
                            <TextBlock Text="Cycle Configuration" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Padding="16" Spacing="16">
                            <CalendarDatePicker Header="Start period date" Date="{x:Bind ViewModel.StartPeriodDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>

                            <NumberBox Header="Cycle days (20-45)" Value="{x:Bind ViewModel.CycleDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
           Minimum="20" Maximum="45" SmallChange="1" SpinButtonPlacementMode="Inline"/>

                            <NumberBox Header="Period lasts (1-9)" Value="{x:Bind ViewModel.PeriodLasts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
           Minimum="1" Maximum="9" SmallChange="1" SpinButtonPlacementMode="Inline"/>

                            <ComboBox Header="PMS symptoms appear" SelectedIndex="{x:Bind ViewModel.PmsOption, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Not applicable" />
                                <ComboBoxItem Content="1-3 days before period" />
                                <ComboBoxItem Content="4-7 days before period" />
                                <ComboBoxItem Content="7-14 days before period" />
                            </ComboBox>

                            <Button Content="Save Cycle" Click="SaveCycle_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Border Background="#196f53" Padding="12" CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="Daily Symptom Notes" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="White" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.Notes.Count, Mode=OneWay}" Foreground="Black" />
                                </Border>
                            </Grid>
                        </Border>

                        <ListView ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}" SelectionMode="None" MaxHeight="250">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PeriodTrackerNoteItemViewModel">
                                    <Grid ColumnSpacing="8" Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsDone, Mode=TwoWay}" Click="NoteCheckBox_Click" Tag="{x:Bind}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Body, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Grid.Column="2" Content="X" Background="Transparent" Foreground="Red" Click="DeleteNote_Click" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Padding="16" Spacing="8" Background="#f8f8f8">
                            <TextBox Header="Add a new note" 
         Text="{x:Bind ViewModel.NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
         PlaceholderText="Describe symptoms..." 
         IsEnabled="{x:Bind ViewModel.CanAddNote, Mode=OneWay}"/>
                            <Button Content="Add Note" Click="AddNote_Click" IsEnabled="{x:Bind ViewModel.CanAddNote, Mode=OneWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Visibility="{x:Bind GetDashboardVisibility(ViewModel.HasPeriodTracker), Mode=OneWay}" 
                        Margin="0,32,0,0" Spacing="16">

                <TextBlock Text="Recommended related wellness items" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}"/>

                <ListView ItemsSource="{x:Bind ViewModel.ShopItems, Mode=OneWay}" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionMode="None">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource SystemAccentColor}" BorderThickness="0,4,0,0" 
                                    Background="{StaticResource AppSurfaceBrush}" CornerRadius="8" Padding="16" Width="220">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding RawItem.Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                    <TextBlock Text="{Binding RawItem.Producer}" Foreground="Gray" FontSize="12" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding RawItem.Price}" TextDecorations="Strikethrough" 
                                                   Foreground="{StaticResource AppErrorBrush}" FontSize="12" VerticalAlignment="Bottom"
                                                   Visibility="{Binding HasDiscountApplied, Converter={StaticResource InlineBoolToVis}}"/>

                                        <TextBlock Text="{Binding DisplayPrice}" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" FontSize="16"/>
                                        <TextBlock Text="Lei" FontSize="12" VerticalAlignment="Bottom"/>
                                    </StackPanel>

                                    <Button Content="Add to basket" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>