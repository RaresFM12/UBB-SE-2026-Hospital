<Page
    x:Class="Hospital.Desktop.Views.Pharmacy.OrdersPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Your Orders" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1" Padding="12">
            <ListView ItemsSource="{Binding Orders}">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Order #" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Pickup Date" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Completed" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Expired" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Items" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Actions" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" Foreground="{StaticResource AppTextPrimaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding PickUpDate}" Foreground="{StaticResource AppTextPrimaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding IsCompleted}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding IsExpired}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding ItemCount}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <Button Grid.Column="5" Content="Cancel" Command="{Binding DataContext.CancelOrderCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Page>
