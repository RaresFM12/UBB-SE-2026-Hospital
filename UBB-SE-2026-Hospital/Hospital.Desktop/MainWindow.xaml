<Window
    x:Class="Hospital.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hospital Desktop">

    <Grid>
        <NavigationView
            x:Name="ShellNavigationView"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home"/>

                <NavigationViewItemHeader Content="Admin &amp; Client"/>
                <NavigationViewItem Content="Accounts" Tag="AdminAccounts" Icon="Contact"/>
                <NavigationViewItem Content="Appointments" Tag="Appointments" Icon="Calendar"/>
                <NavigationViewItem Content="ER Dispatch" Tag="ERDispatch" Icon="Mail"/>
                <NavigationViewItem Content="Fatigue Audit" Tag="FatigueAudit" Icon="Switch"/>
                <NavigationViewItem Content="Admin Schedule" Tag="AdminSchedule" Icon="CalendarWeek"/>
                <NavigationViewItem Content="Admin Shift" Tag="AdminShift" Icon="People"/>

                <NavigationViewItemHeader Content="Emergency Room"/>
                <NavigationViewItem Content="Triage" Tag="Triage" Icon="Favorite"/>
                <NavigationViewItem Content="Queue" Tag="Queue" Icon="List"/>
                <NavigationViewItem Content="Patient Registration" Tag="PatientRegistration" Icon="AddFriend"/>
                <NavigationViewItem Content="Room Management" Tag="RoomManagement" Icon="DockLeft"/>
                <NavigationViewItem Content="Room Assignment" Tag="RoomAssignment" Icon="Assign"/>
                <NavigationViewItem Content="Examination" Tag="Examination" Icon="Document"/>
                <NavigationViewItem Content="Transfer Log" Tag="TransferLog" Icon="Forward"/>

                <NavigationViewItemHeader Content="Patient &amp; Billing"/>
                <NavigationViewItem Content="Patients" Tag="Patients" Icon="Contact2"/>
                <NavigationViewItem Content="Prescriptions" Tag="Prescriptions" Icon="Medication"/>
                <NavigationViewItem Content="Transplants" Tag="Transplants" Icon="Organize"/>
                <NavigationViewItem Content="Blood Donors" Tag="BloodDonors" Icon="Drop"/>
                <NavigationViewItem Content="Statistics" Tag="Statistics" Icon="Chart"/>
                <NavigationViewItem Content="Billing" Tag="Billing" Icon="Shop"/>
                <NavigationViewItem Content="Addict Detection" Tag="AddictDetection" Icon="Police"/>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button
                    x:Name="LogoutButton"
                    Content="Logout"
                    Margin="12"
                    Click="OnLogoutClick"/>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Padding="12"/>
        </NavigationView>
    </Grid>
</Window>
