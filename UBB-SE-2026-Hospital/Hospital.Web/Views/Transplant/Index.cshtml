@model Hospital.Web.Models.Transplant.TransplantLookupViewModel
@{
    ViewData["Title"] = "Organ Transplant Waitlist";
}

<div class="container mt-4" style="max-width: 720px;">
    <h1 class="mb-3">Organ Transplant Waitlist</h1>
    <p class="text-muted">Open the waitlist request form for a patient and choose the required organ.</p>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Request" class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PatientId" class="form-label">Patient ID</label>
                    <input asp-for="PatientId"
                           class="form-control"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="Enter a patient ID"
                           autofocus />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Open request form</button>
                </div>
            </form>
        </div>
    </div>
</div>
