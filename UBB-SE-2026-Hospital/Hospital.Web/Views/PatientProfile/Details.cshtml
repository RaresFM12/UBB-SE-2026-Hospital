@model Hospital.Web.Models.Patient.PatientProfileViewModel

@{
    ViewData["Title"] = "Patient Medical Profile";
}

@if (Model.IsHighRisk)
{
    <div class="alert alert-warning fw-semibold">
        ⚠️ Warning: This patient is flagged as High Risk.
    </div>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Patient Medical Profile</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Patients</a>
</div>

<div class="row g-4">

    @* Left panel — general info + medical history *@
    <div class="col-md-4">
        <div class="card h-100 p-4">
            <h5 class="fw-bold mb-3">General Information</h5>
            <p class="fs-5 mb-1">@Model.FirstName @Model.LastName</p>
            <p class="text-muted mb-1">CNP: @Model.Cnp</p>
            <p class="text-muted mb-1">DOB: @Model.Dob.ToString("yyyy-MM-dd")</p>
            <p class="text-muted mb-1">Sex: @Model.Sex</p>
            <p class="text-muted mb-1">Phone: @Model.PhoneNo</p>
            <p class="text-muted mb-4">Emergency: @Model.EmergencyContact</p>

            <hr />

            <h6 class="fw-semibold mb-3">Medical History</h6>
            <p><span class="text-muted">Blood Type: </span>@Model.BloodType</p>
            <p><span class="text-muted">RH Factor: </span>@Model.Rh</p>
            <p><span class="text-muted">Chronic Conditions: </span><br /><span class="ms-2">@Model.ChronicConditions</span></p>
            <p>
                <span class="text-muted">Allergies: </span><br />
                <span class="ms-2">@(Model.Allergies.Any() ? string.Join(", ", Model.Allergies) : "None")</span>
            </p>

            <hr />

            <div>
                <button class="btn btn-outline-secondary w-100 text-start"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#fileRecords">
                    File Records ▾
                </button>
                <div class="collapse mt-2 @(Model.SelectedRecordId.HasValue ? "show" : "")" id="fileRecords">
                    @if (!Model.MedicalRecords.Any())
                    {
                        <p class="text-muted ms-2">No records.</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var r in Model.MedicalRecords)
                            {
                                <li class="list-group-item @(Model.SelectedRecordId == r.Id ? "active" : "")"
                                    style="cursor:pointer"
                                    onclick="window.location='@Url.Action("PatientProfile", "Patients", new { id = Model.Id, selectedRecordId = r.Id })'">
                                    @r.ConsultationDate.ToShortDateString()
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Right panel — consultation details *@
    <div class="col-md-8">
        <div class="card h-100 p-4">
            @if (Model.SelectedRecord is null)
            {
                <p class="text-muted">Select a record from File Records to view consultation details.</p>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Consultation Details</h5>
                    <div class="d-flex gap-2">
                        @if (Model.SelectedPrescription is not null)
                        {
                            <a asp-controller="Pharmacist"
                               asp-action="PrescriptionDetail"
                               asp-route-id="@Model.SelectedPrescription.Id"
                               asp-route-returnPatientId="@Model.Id"
                               asp-route-returnRecordId="@Model.SelectedRecordId"
                               class="btn btn-primary btn-sm">📋 View Prescription</a>
                        }
                        @if (Model.SelectedRecord.DiscountApplied.GetValueOrDefault() == 0)
                        {
                            <a asp-controller="Roulette"
                               asp-action="Spin"
                               asp-route-patientId="@Model.Id"
                               asp-route-recordId="@Model.SelectedRecordId"
                               class="btn btn-warning btn-sm">🎡 Apply Discount</a>
                        }
                        else
                        {
                            <span class="badge bg-success align-self-center">✓ @Model.SelectedRecord.DiscountApplied% off</span>
                        }
                    </div>
                </div>
                <dl class="row">
                    <dt class="col-sm-4 text-muted">Patient Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.FirstName @Model.LastName</dd>

                    <dt class="col-sm-4 text-muted">Date</dt>
                    <dd class="col-sm-8">@Model.SelectedRecord.ConsultationDate.ToShortDateString()</dd>

                    <dt class="col-sm-4 text-muted">Source</dt>
                    <dd class="col-sm-8">@Model.SelectedRecord.SourceType</dd>

                    <dt class="col-sm-4 text-muted">Staff ID</dt>
                    <dd class="col-sm-8">@Model.SelectedRecord.StaffId</dd>

                    <dt class="col-sm-4 text-muted">Reported Symptoms</dt>
                    <dd class="col-sm-8">@Model.SelectedRecord.Symptoms</dd>

                    <dt class="col-sm-4 text-muted">Diagnosis</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.SelectedRecord.Diagnosis</dd>

                    <dt class="col-sm-4 text-muted">Base Price</dt>
                    <dd class="col-sm-8">@Model.SelectedRecord.BasePrice.ToString("C")</dd>

                    <dt class="col-sm-4 text-muted">Final Price</dt>
                    <dd class="col-sm-8">@Model.SelectedRecord.FinalPrice.ToString("C")</dd>

                    @if (Model.SelectedRecord.DiscountApplied.HasValue && Model.SelectedRecord.DiscountApplied > 0)
                    {
                        <dt class="col-sm-4 text-muted">Discount</dt>
                        <dd class="col-sm-8">@Model.SelectedRecord.DiscountApplied%</dd>
                    }
                </dl>
            }
        </div>
    </div>
</div>
