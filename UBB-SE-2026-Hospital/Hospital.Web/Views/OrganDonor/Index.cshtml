@model Hospital.Web.Models.Transplant.OrganDonorViewModel

@{
    ViewData["Title"] = "Organ Donor Assignment";
}

<div class="container mt-4">
    <h1 class="mb-3">Organ Donor Assignment</h1>
    <p class="text-muted">Choose the living recipient and needed organ, then review the compatible deceased donors.</p>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @if (Model.RecipientPatients.Count == 0)
            {
                <div class="text-muted">No living patients were found.</div>
            }
            else
            {
                <form method="post" asp-action="FindDonors" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-7">
                        <label for="recipientPatientLookup" class="form-label">Recipient patient</label>
                        <input id="recipientPatientLookup"
                               class="form-control"
                               list="recipientPatients"
                               placeholder="Type name or exact CNP"
                               autocomplete="off"
                               value="@(Model.PatientId > 0 ? $"{Model.PatientName} ({Model.RecipientSearchQuery})" : string.Empty)"
                               required />
                        <datalist id="recipientPatients">
                            @foreach (var patient in Model.RecipientPatients)
                            {
                                <option value="@patient.FirstName @patient.LastName (@patient.Cnp)" data-patient-id="@patient.Id"></option>
                            }
                        </datalist>
                        <input id="recipientPatientId" name="patientId" type="hidden" value="@(Model.PatientId > 0 ? Model.PatientId : 0)" required />
                    </div>
                    <div class="col-md-3">
                        <label for="recipientOrgan" class="form-label">Needed organ</label>
                        <select id="recipientOrgan" name="organ" class="form-select" required>
                            <option value="">Choose an organ...</option>
                            @foreach (var organ in Model.Organs)
                            {
                                <option value="@organ" selected="@(Model.SelectedOrgan == organ ? "selected" : null)">@organ</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">Find Donors</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                    </div>
                </form>
            }
        </div>
    </div>

    @if (Model.TopDonors.Count > 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 mb-1">Compatible Deceased Donors</h2>
                <p class="text-muted mb-0">Recipient: <strong>@Model.PatientName</strong> | Organ: <strong>@Model.SelectedOrgan</strong></p>
            </div>
        </div>

        <form method="post" asp-action="Confirm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" value="@Model.PatientId" />
            <input type="hidden" name="transplantId" value="@Model.PendingTransplantId" />
            <input type="hidden" id="compatibilityScore" name="compatibilityScore" value="0" />

            <div class="table-responsive mb-3">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th>Donor</th>
                            <th>CNP</th>
                            <th>Blood Type</th>
                            <th>Rh</th>
                            <th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var donor in Model.TopDonors)
                        {
                            <tr>
                                <td>
                                    <input type="radio"
                                           name="donorId"
                                           value="@donor.PatientId"
                                           class="form-check-input"
                                           data-score="@donor.Score"
                                           onchange="document.getElementById('compatibilityScore').value = this.dataset.score"
                                           required />
                                </td>
                                <td>@donor.FullName</td>
                                <td>@donor.Cnp</td>
                                <td>@donor.BloodType</td>
                                <td>@donor.RhFactor</td>
                                <td><span class="fw-bold text-success">@donor.Score</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary">Confirm Assignment</button>
        </form>
    }
</div>

<script>
    (() => {
        const input = document.getElementById("recipientPatientLookup");
        const list = document.getElementById("recipientPatients");
        const hidden = document.getElementById("recipientPatientId");
        const form = input?.closest("form[action$='FindDonors']");

        if (!input || !list || !hidden || !form) {
            return;
        }

        const syncSelection = () => {
            const option = Array.from(list.options).find(item => item.value === input.value);
            hidden.value = option?.dataset.patientId ?? "";
        };

        input.addEventListener("input", syncSelection);
        input.addEventListener("change", syncSelection);

        form.addEventListener("submit", event => {
            syncSelection();

            if (!hidden.value) {
                event.preventDefault();
                input.setCustomValidity("Please choose a patient from the suggestions.");
                input.reportValidity();
                return;
            }

            input.setCustomValidity("");
        });
    })();
</script>
