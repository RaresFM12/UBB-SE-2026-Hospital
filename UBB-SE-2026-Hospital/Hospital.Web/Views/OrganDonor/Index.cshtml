@model Hospital.Web.Models.Transplant.OrganDonorViewModel

@{
    ViewData["Title"] = "Organ Donor Assignment";
}

<div class="container mt-4">
    <h1 class="mb-3">Organ Donor Assignment</h1>
    <p class="text-muted">Create transplant requests for living patients, then match a deceased donor to the waiting list.</p>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h4 mb-3">1. Living Recipient</h2>
                    <p class="text-muted">Type a name or exact CNP, then pick the living patient from the suggestions.</p>

                    @if (Model.RecipientPatients.Count == 0)
                    {
                        <div class="text-muted">No living patients were found.</div>
                    }
                    else
                    {
                        <form method="post" asp-action="CreateRequest" class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-12">
                                <label for="recipientPatientLookup" class="form-label">Recipient patient</label>
                                <input id="recipientPatientLookup"
                                       class="form-control"
                                       list="recipientPatients"
                                       placeholder="Start typing a name or exact CNP"
                                       autocomplete="off"
                                       required />
                                <datalist id="recipientPatients">
                                    @foreach (var patient in Model.RecipientPatients)
                                    {
                                        <option value="@patient.FirstName @patient.LastName (@patient.Cnp)" data-patient-id="@patient.Id"></option>
                                    }
                                </datalist>
                                <input id="recipientPatientId" name="patientId" type="hidden" required />
                            </div>
                            <div class="col-12">
                                <label for="recipientOrgan" class="form-label">Needed organ</label>
                                <select id="recipientOrgan" name="organ" class="form-select" required>
                                    <option value="">Choose an organ...</option>
                                    @foreach (var organ in Model.Organs)
                                    {
                                        <option value="@organ">@organ</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Add to Waitlist</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h4 mb-3">2. Deceased Donor</h2>
                    <p class="text-muted">Type a name or exact CNP, then pick the deceased patient from the suggestions.</p>

                    @if (Model.DonorPatients.Count == 0)
                    {
                        <div class="text-muted">No deceased patients were found for organ donation.</div>
                    }
                    else
                    {
                        <form method="get" asp-action="Assign" class="row g-3">
                            <div class="col-12">
                                <label for="donorPatientLookup" class="form-label">Donor patient</label>
                                <input id="donorPatientLookup"
                                       class="form-control"
                                       list="donorPatients"
                                       placeholder="Start typing a name or exact CNP"
                                       autocomplete="off"
                                       required />
                                <datalist id="donorPatients">
                                    @foreach (var patient in Model.DonorPatients)
                                    {
                                        <option value="@patient.FirstName @patient.LastName (@patient.Cnp)" data-patient-id="@patient.Id"></option>
                                    }
                                </datalist>
                                <input id="donorPatientId" name="patientId" type="hidden" required />
                            </div>
                            <div class="col-12">
                                <label for="donorOrgan" class="form-label">Available organ</label>
                                <select id="donorOrgan" name="organ" class="form-select" required>
                                    <option value="">Choose an organ...</option>
                                    @foreach (var organ in Model.Organs)
                                    {
                                        <option value="@organ">@organ</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Search Matches</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        function bindPatientLookup(inputId, listId, hiddenId, formSelector) {
            const input = document.getElementById(inputId);
            const list = document.getElementById(listId);
            const hidden = document.getElementById(hiddenId);
            const form = input?.closest(formSelector);

            if (!input || !list || !hidden || !form) {
                return;
            }

            const syncSelection = () => {
                const option = Array.from(list.options).find(item => item.value === input.value);
                hidden.value = option?.dataset.patientId ?? "";
            };

            input.addEventListener("input", syncSelection);
            input.addEventListener("change", syncSelection);

            form.addEventListener("submit", event => {
                syncSelection();

                if (!hidden.value) {
                    event.preventDefault();
                    input.setCustomValidity("Please choose a patient from the suggestions.");
                    input.reportValidity();
                    return;
                }

                input.setCustomValidity("");
            });
        }

        bindPatientLookup("recipientPatientLookup", "recipientPatients", "recipientPatientId", "form");
        bindPatientLookup("donorPatientLookup", "donorPatients", "donorPatientId", "form");
    })();
</script>
