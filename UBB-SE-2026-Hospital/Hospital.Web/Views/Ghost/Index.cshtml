@model Hospital.Web.Models.Ghost.GhostViewModel
@{
    ViewData["Title"] = "Ghost Sighting Monitor";
}

<h2>Ghost Sighting Monitor</h2>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (Model.StatusMessage is not null)
{
    <div class="alert @(Model.ExorcismTriggered ? "alert-danger" : "alert-info")">
        @Model.StatusMessage
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Current Status</h5>
        <p>Sightings in the last 24 hours: <strong>@Model.SightingCount</strong></p>
        <p>
            Exorcism status:
            @if (Model.ExorcismTriggered)
            {
                <span class="badge bg-danger">Triggered</span>
            }
            else
            {
                <span class="badge bg-success">All clear</span>
            }
        </p>
        <small class="text-muted">Last refreshed: @Model.LastRefreshed.ToString("yyyy-MM-dd HH:mm:ss") UTC</small>
    </div>
</div>

<form asp-action="ReportSighting" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-warning" disabled="@(Model.ExorcismTriggered ? "disabled" : null)">Report Sighting</button>
</form>

@if (Model.ExorcismTriggered)
{
    <div id="ghost-lockdown" role="alertdialog" aria-modal="true" aria-label="Spectral lockdown">
        <div class="ghost-lockdown-box">
            <div class="ghost-emoji">👻</div>
            <h1>TOO MANY GHOSTS SIGHTED!</h1>
            <p class="ghost-subtitle">Call the priest immediately!</p>
            <p class="ghost-note">
                The hospital is under spectral lockdown. More than three sightings were reported in the last 24 hours.
                This warning cannot be dismissed and will only clear once the system has been restarted (and blessed).
            </p>
        </div>
    </div>

    <style>
        body { overflow: hidden; }

        #ghost-lockdown {
            position: fixed;
            inset: 0;
            z-index: 2147483647;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: ghost-flash 1.1s steps(1) infinite;
        }

        @@keyframes ghost-flash {
            0%, 49% { background-color: rgba(20, 0, 0, 0.95); }
            50%, 100% { background-color: rgba(75, 0, 0, 0.97); }
        }

        .ghost-lockdown-box {
            max-width: 640px;
            padding: 2rem;
            text-align: center;
            color: #fff;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .ghost-emoji {
            font-size: 6rem;
            animation: ghost-float 2s ease-in-out infinite;
        }

        @@keyframes ghost-float {
            0%, 100% { transform: translateY(0) rotate(-3deg); }
            50% { transform: translateY(-18px) rotate(3deg); }
        }

        #ghost-lockdown h1 {
            margin: .5rem 0;
            font-weight: 800;
            letter-spacing: 1px;
            color: #ff4d4d;
            text-shadow: 0 0 18px rgba(255, 0, 0, .7);
        }

        .ghost-subtitle {
            margin: 0 0 1rem;
            font-size: 1.6rem;
            font-weight: 700;
        }

        .ghost-note {
            color: #ddd;
            font-size: .95rem;
            line-height: 1.5;
        }
    </style>

    <script>
        (function () {
            // Spooky alarm siren via the Web Audio API — no audio file required.
            var audioCtx = null;
            function ensureAlarm() {
                try {
                    if (!audioCtx) {
                        var Ctx = window.AudioContext || window.webkitAudioContext;
                        if (!Ctx) { return; }
                        audioCtx = new Ctx();
                        var osc = audioCtx.createOscillator();
                        var gain = audioCtx.createGain();
                        osc.type = 'sawtooth';
                        gain.gain.value = 0.06;
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start();
                        var high = true;
                        setInterval(function () {
                            osc.frequency.setValueAtTime(high ? 660 : 380, audioCtx.currentTime);
                            high = !high;
                        }, 450);
                    }
                    if (audioCtx.state === 'suspended') { audioCtx.resume(); }
                } catch (e) { /* audio unavailable — fail silently */ }
            }

            // Try right away; if the browser blocks autoplay, start on the first click anywhere.
            ensureAlarm();
            window.addEventListener('click', ensureAlarm);
        })();
    </script>
}
