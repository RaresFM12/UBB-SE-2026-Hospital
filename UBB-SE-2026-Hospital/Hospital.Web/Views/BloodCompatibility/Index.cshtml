@{
    ViewData["Title"] = "Blood Compatibility";
}

<div class="container mt-4" style="max-width: 640px;">
    <h1 class="mb-3">Blood Compatibility</h1>
    <p class="text-muted">Enter a patient ID to view compatible blood donors.</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Donors" class="row g-3">
                <div class="col-12">
                    <label for="patientId" class="form-label">Patient ID</label>
                    <input id="patientId" name="patientId" type="number" class="form-control" min="1" required />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Show donors</button>
                </div>
            </form>
        </div>
    </div>
</div>