@model HangoutsIndexViewModel
@{
    ViewData["Title"] = "Hangouts";
}

<h2 class="mb-4">Hangouts</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Schedule Hangout</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Doctors.Any())
{
    <div class="mb-4 p-3 border rounded bg-light">
        <label for="doctorFilter" class="form-label fw-bold mb-0">Filter by doctor:</label>
        <select id="doctorFilter" class="form-select w-auto d-inline-block ms-2">
            <option value="">All doctors</option>
            @foreach (DoctorOptionViewModel doctor in Model.Doctors)
            {
                <option value="@doctor.DoctorId">@doctor.DoctorName</option>
            }
        </select>
    </div>
}

@if (!Model.Hangouts.Any())
{
    <p class="text-muted">No hangouts scheduled.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="hangoutList">
        @foreach (HangoutViewModel hangout in Model.Hangouts)
        {
            <div class="col hangout-card" data-participants="@string.Join(",", hangout.ParticipantStaffIds)">
                <div class="card h-100 @(hangout.IsFull ? "border-secondary" : "border-primary")">
                    <div class="card-body">
                        <h5 class="card-title">@hangout.Title</h5>
                        <p class="card-text text-muted">@hangout.Description</p>
                        <p class="card-text">
                            <small class="text-muted">Date: @hangout.FormattedDate</small>
                        </p>
                        <p class="card-text">
                            Participants: @hangout.ParticipantCount / @hangout.MaxParticipants
                            @if (hangout.IsFull)
                            {
                                <span class="badge bg-secondary ms-1">Full</span>
                            }
                        </p>
                    </div>
                    <div class="card-footer">
                        @if (hangout.IsAlreadyJoined)
                        {
                            <span class="badge bg-success">Joined</span>
                        }
                        else if (!hangout.IsFull && Model.CurrentStaffId.HasValue)
                        {
                            <form asp-action="Join" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="hangoutId" value="@hangout.HangoutId" />
                                <input type="hidden" name="staffId" value="@Model.CurrentStaffId" />
                                <button type="submit" class="btn btn-sm btn-primary">Join</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            var filter = document.getElementById('doctorFilter');
            if (!filter) return;

            function applyFilter() {
                var selected = filter.value;
                document.querySelectorAll('.hangout-card').forEach(function (card) {
                    var participants = (card.dataset.participants || '').split(',').filter(Boolean);
                    var show = selected === '' || participants.includes(selected);
                    card.style.display = show ? '' : 'none';
                });
            }

            filter.addEventListener('change', applyFilter);
            applyFilter();
        }());
    </script>
}
